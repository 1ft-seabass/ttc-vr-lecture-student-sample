[{"id":"flow_07","type":"tab","label":"07-passthrough-device-control","disabled":false,"info":"VR側の立方体タップをWebSocketで受信し、実デバイスへのMQTT publishとVRへのブロードキャスト応答を同時に行うフローと、1秒おきにサーバー時刻(JST)をブロードキャストするフロー。"},{"id":"g_device","type":"group","z":"flow_07","name":"デバイス操作の受信・MQTT publish・VR折り返し","style":{"label":true},"nodes":["ws_in_device_control","fn_toggle_device_state","mqtt_out_device_control","ws_out_device_control"],"x":34,"y":19,"w":952,"h":162},{"id":"g_clock","type":"group","z":"flow_07","name":"常時時計配信(1秒おき)","style":{"label":true},"nodes":["inject_clock_tick","fn_build_clock_message","68bd2c7922a03ee0"],"x":34,"y":219,"w":932,"h":82},{"id":"mqtt_broker_device","type":"mqtt-broker","name":"デバイス操作MQTTブローカー(要設定)","broker":"YOUR_MQTT_BROKER_HOST","port":"8883","tls":"","clientid":"","autoConnect":true,"usetls":true,"protocolVersion":"4","keepalive":"60","cleansession":true,"autoUnsubscribe":true,"birthTopic":"","birthQos":"0","birthPayload":"","birthMsg":{},"closeTopic":"","closeQos":"0","closePayload":"","closeMsg":{},"willTopic":"","willQos":"0","willPayload":"","willMsg":{},"userProps":"","sessionExpiry":""},{"id":"ws_listener_device_control","type":"websocket-listener","path":"/ws/device-control","wholemsg":"false"},{"id":"ws_in_device_control","type":"websocket in","z":"flow_07","g":"g_device","name":"WebSocket受信(/ws/device-control)","server":"ws_listener_device_control","client":"","x":200,"y":100,"wires":[["fn_toggle_device_state"]]},{"id":"fn_toggle_device_state","type":"function","z":"flow_07","g":"g_device","name":"state toggle+_session削除","func":"let state = flow.get('deviceState') || 'off';\nstate = state === 'off' ? 'on' : 'off';\nflow.set('deviceState', state);\n\n// _sessionが残っていると特定クライアントへのreplyになるため削除し、\n// 接続中の全クライアントへブロードキャストされるようにする\ndelete msg._session;\n\n// このpayloadはmqtt out(実機向け)にもそのまま渡るため、\n// type等の余分なフィールドは付与せずstateのみに保つ\nmsg.payload = { state: state };\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":500,"y":100,"wires":[["mqtt_out_device_control","ws_out_device_control"]]},{"id":"mqtt_out_device_control","type":"mqtt out","z":"flow_07","g":"g_device","name":"MQTT publish(classroom/device/control)","topic":"classroom/device/control","qos":"0","retain":"","respTopic":"","contentType":"","userProps":"","correl":"","expiry":"","broker":"mqtt_broker_device","x":800,"y":60,"wires":[]},{"id":"ws_out_device_control","type":"websocket out","z":"flow_07","g":"g_device","name":"WebSocket送信(全クライアントへ)","server":"ws_listener_device_control","client":"","x":780,"y":140,"wires":[]},{"id":"inject_clock_tick","type":"inject","z":"flow_07","g":"g_clock","name":"1秒ごとに実行","props":[{"p":"payload"}],"repeat":"1","crontab":"","once":true,"onceDelay":0.1,"topic":"","payload":"","payloadType":"date","x":160,"y":260,"wires":[["fn_build_clock_message"]]},{"id":"fn_build_clock_message","type":"function","z":"flow_07","g":"g_clock","name":"サーバー時刻(JST)を組み立て","func":"const now = new Date();\nmsg.payload = {\n  type: 'clock',\n  serverTimeJST: now.toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo', hour12: false }),\n};\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":460,"y":260,"wires":[["68bd2c7922a03ee0"]]},{"id":"68bd2c7922a03ee0","type":"websocket out","z":"flow_07","g":"g_clock","name":"WebSocket送信(全クライアントへ)","server":"ws_listener_device_control","client":"","x":800,"y":260,"wires":[]}]