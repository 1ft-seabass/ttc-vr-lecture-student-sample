[{"id":"flow_06","type":"tab","label":"06-passthrough-tap-cube","disabled":false,"info":"VR側の立方体タップをWebSocketで受け状態トグル+往復時間を返すフローと、1秒おきにサーバー時刻(JST)をブロードキャストするフロー。"},{"id":"g_ws","type":"group","z":"flow_06","name":"タップ操作の受信と応答","style":{"label":true},"nodes":["ws_in_device_control","fn_toggle_state","ws_out_device_control"],"x":34,"y":39,"w":892,"h":82},{"id":"g_clock","type":"group","z":"flow_06","name":"常時時計配信(1秒おき)","style":{"label":true},"nodes":["inject_clock_tick","fn_build_clock_message"],"x":34,"y":159,"w":652,"h":82},{"id":"ws_listener_device_control","type":"websocket-listener","path":"/ws/device-control","wholemsg":"false"},{"id":"ws_in_device_control","type":"websocket in","z":"flow_06","g":"g_ws","name":"WebSocket受信(/ws/device-control)","server":"ws_listener_device_control","client":"","x":210,"y":80,"wires":[["fn_toggle_state"]]},{"id":"fn_toggle_state","type":"function","z":"flow_06","g":"g_ws","name":"state toggle+サーバー時刻付与","func":"let state = flow.get('cubeState') || 'off';\nstate = state === 'off' ? 'on' : 'off';\nflow.set('cubeState', state);\n\n// _sessionが残っていると特定クライアントへのreplyになるため削除し、\n// 接続中の全クライアントへブロードキャストされるようにする\ndelete msg._session;\n\nmsg.payload = {\n  type: 'tap',\n  state: state,\n  serverTime: Date.now(),\n};\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":500,"y":80,"wires":[["ws_out_device_control"]]},{"id":"inject_clock_tick","type":"inject","z":"flow_06","g":"g_clock","name":"1秒ごとに実行","props":[{"p":"payload"}],"repeat":"1","crontab":"","once":true,"onceDelay":0.1,"topic":"","payload":"","payloadType":"date","x":210,"y":200,"wires":[["fn_build_clock_message"]]},{"id":"fn_build_clock_message","type":"function","z":"flow_06","g":"g_clock","name":"サーバー時刻(JST)を組み立て","func":"const now = new Date();\nmsg.payload = {\n  type: 'clock',\n  serverTimeJST: now.toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo', hour12: false }),\n};\nreturn msg;","outputs":1,"timeout":"","noerr":0,"initialize":"","finalize":"","libs":[],"x":500,"y":200,"wires":[["ws_out_device_control"]]},{"id":"ws_out_device_control","type":"websocket out","z":"flow_06","g":"g_ws","name":"WebSocket送信(全クライアントへ)","server":"ws_listener_device_control","client":"","x":810,"y":80,"wires":[]}]